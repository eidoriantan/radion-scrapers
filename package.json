    "name": "Adriane Justine Tan",
    "email": "eidoriantan@gmail.com",
    "url": "https://eidoriantan.me"
  },
  "main": "server/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidoriantan/radion-scrapers.git"
  },
  "scripts": {
    "objkt:start": "forever start scripts/objkt.js",
    "objkt:stop": "forever stop scripts/objkt.js",
    "melos:start": "forever start scripts/melos.js",
    "melos:stop": "forever stop scripts/melos.js",
    "contract:start": "forever start scripts/contract.js",
    "contract:stop": "forever stop scripts/contract.js",
    "opensea:start": "forever start scripts/opensea.js",
    "opensea:stop": "forever stop scripts/opensea.js",
    "tunefm:start": "forever start scripts/tunefm.js",
    "tunefm:stop": "forever stop scripts/tunefm.js",
    "soundxyz:start": "forever start scripts/soundxyz.js",
    "soundxyz:stop": "forever stop scripts/soundxyz.js",
    "server": "forever start server/index.js",
    "lint": "standard",
    "postlint": "git log -1 --format=%B | commitlint",
    "pretest": "npm run lint",
    "test": "echo \"Error: no test specified\" && exit 0"
